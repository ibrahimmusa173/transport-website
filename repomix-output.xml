// --- Start of new structural approach for src/context/AuthContext.jsx ---

import PropTypes from "prop-types";
import { useState, useEffect } from 'react';
import { loginUser, fetchUserProfile, registerUser as apiRegisterUser } from '../api/auth';
// Assuming AuthContext and useAuth are defined and exported elsewhere:
import { AuthContext } from './AuthContext'; // Or wherever the Context object is defined

// NOTE: We must ensure we remove the export of useAuth and AuthContext from this file
// if we want to resolve the 'react-refresh/only-export-components' warning.

export const AuthProvider = ({ children }) => {
    // ... (logic remains identical)
    const [user, setUser] = useState(null);
    const [token, setToken] = useState(() => localStorage.getItem('authToken') || null);
    const [isLoading, setIsLoading] = useState(true);
    const [error, setError] = useState(null);

    useEffect(() => {
        const loadUser = async () => {
            if (token) {
                try {
                    const profileData = await fetchUserProfile(token); 
                    setUser(profileData.user || profileData);
                } catch (err) {
                    console.error("Token verification failed, logging out:", err);
                    logout();
                }
            }
            setIsLoading(false);
        };
        loadUser();
    }, [token]);

    // ... (rest of functions: handleAuthSuccess, login, register, logout)
    const handleAuthSuccess = (data) => {
        const receivedToken = data.token;
        const receivedUser = data.user || data;

        if (receivedToken) {
            setToken(receivedToken);
            localStorage.setItem('authToken', receivedToken);
        }
        setUser(receivedUser);
        setError(null);
    };

    const login = async (credentials) => {
        setIsLoading(true);
        try {
            const data = await loginUser(credentials);
            handleAuthSuccess(data);
        } catch (err) {
            setError(err.message || 'Login failed');
            throw err;
        } finally {
            setIsLoading(false);
        }
    };

    const register = async (credentials) => {
        setIsLoading(true);
        try {
            const data = await apiRegisterUser(credentials); 
            if (data.token) handleAuthSuccess(data);
            return data;
        } catch (err) {
            setError(err.message || 'Registration failed');
            throw err;
        } finally {
            setIsLoading(false);
        }
    };

    const logout = () => {
        setToken(null);
        setUser(null);
        localStorage.removeItem('authToken');
    };

    return (
        <AuthContext.Provider value={{ user, token, isAuthenticated: !!user, isLoading, error, login, register, logout }}>
            {isLoading && token && !user ? (
                <div className="flex justify-center items-center h-screen text-xl">Loading...</div>
            ) : (
                children
            )}
        </AuthContext.Provider>
    );
};

AuthProvider.propTypes = {
    children: PropTypes.node.isRequired,
};

// --- End of new structural approach for src/context/AuthContext.jsx ---
</file>

